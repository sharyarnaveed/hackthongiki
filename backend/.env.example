# Copy to backend/.env and fill in.

# ---- Database ----
# MongoDB connection string (required), e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB=
# Database name inside the cluster.
DB_NAME=pixelart_office

# ---- Email (verification codes, invitations) ----
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="TheSpace <no-reply@example.com>"

# ---- App ----
# Port the API listens on.
PORT=4000
# Frontend URL used in email links. Use your ngrok link when sharing.
CLIENT_URL=http://localhost:3000
# Frontend origins allowed to call the API and open the live socket (comma-separated, * = any subdomain).
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.app,https://*.ngrok.io

# ---- Logs ----
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
# off hides the one-line access log per request.
LOG_REQUESTS=on
