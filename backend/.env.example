# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local (docker compose up -d) or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/virtual-office

# --- Auth ---
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Files (GridFS) ---
MAX_UPLOAD_BYTES=52428800

# --- LiveKit (office group calls) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Base chain ---
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
DECOR_CONTRACT_ADDRESS=
MARKETPLACE_CONTRACT_ADDRESS=

# --- Webhooks ---
ALCHEMY_WEBHOOK_SIGNING_KEY=
CROSSMINT_WEBHOOK_SECRET=
