# Copy to frontend/main.env.

# ---- API ----
# Where the frontend forwards /api (REST and the live WebSocket): your backend.
API_INTERNAL_URL=http://127.0.0.1:4000
# Where the browser calls the API. Leave empty: on localhost it uses http://localhost:4000,
# through ngrok it uses the page's own address (/api, forwarded to API_INTERNAL_URL).
# Set it only if the API is deployed on its own public domain.
NEXT_PUBLIC_API_URL=

# ---- Voice & video ----
# STUN servers for direct (lowest-latency) connections, comma-separated.
# "off" sends all voice/video through the API relay instead.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302

# ---- Dev server ----
# Extra hosts allowed to open the dev site, comma-separated (ngrok hosts are already allowed).
DEV_ORIGINS=
